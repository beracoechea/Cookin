{
  "expo": {
    "name": "Cooking",
    "slug": "Cooking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fondo.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cooking.Cooking"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fondo.jpg",
        "backgroundColor": "#ffffff",
        "package": "com.cooking.Cooking"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/fondo.jpg"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fondo.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-build-properties",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
