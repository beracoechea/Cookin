{
  "expo": {
    "name": "Cooking",
    "slug": "Cooking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fondo.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cooking.Cooking"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fondo.jpg",
        "backgroundColor": "#ffffff",
        "package": "com.cooking.Cooking"
      },
      "package": "com.cooking.Cooking"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/fondo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fondo.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-build-properties",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7e799a7c-cfe3-4be9-9f8b-7e01cb8879e6"
      }
    },
    "owner": "beracoechea"
  }
}
